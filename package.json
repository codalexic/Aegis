{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.10.0"
  },
  "scripts": {
    "build": "anchor build",
    "idl:sync": "node scripts/idl-sync.mjs",
    "test:program": "vitest run tests/program",
    "localnet": "tsx scripts/localnet/start.ts",
    "devnet:deploy": "tsx scripts/devnet/start.ts",
    "test:devnet": "vitest run scripts/devnet/tests",
    "start:demo": "tsx scripts/stage/start.ts",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "test:sdk": "vitest run packages/sdk/tests",
    "dev": "pnpm --filter web dev",
    "agent": "tsx scripts/agent/start.ts",
    "agent:eval": "tsx scripts/agent/eval-start.ts",
    "test:agent": "vitest run scripts/agent/tests",
    "demo": "tsx scripts/demo/start.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "npm:@anchor-lang/core@1.1.2",
    "@solana/kit": "8.4.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@types/node": "26.6.4",
    "litesvm": "1.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
